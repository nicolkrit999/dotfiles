context "nvim_in_math()"
snippet mean "Sample mean (bar)" w
\bar{${1:x}}$0
endsnippet

context "nvim_in_math()"
snippet variance "Variance" w
\operatorname{Var}(${1:X})$0
endsnippet

context "nvim_in_math()"
snippet covariance "Covariance" w
\operatorname{Cov}(${1:X}, ${2:Y})$0
endsnippet

context "nvim_in_math()"
snippet expect "Expected value" w
\mathbb{E}\left[${1:X}\right]$0
endsnippet

context "nvim_in_math()"
snippet Prob "Probability" w
\mathbb{P}(${1:A})$0
endsnippet

context "nvim_in_math()"
snippet given "Conditional probability" w
\mathbb{P}(${1:A} \mid ${2:B})$0
endsnippet

context "nvim_in_math()"
snippet binom "Binomial coefficient" w
\binom{${1:n}}{${2:k}}$0
endsnippet

context "nvim_in_math()"
snippet normaldist "Normal distribution" w
${1:X} \sim \mathcal{N}(${2:\mu}, ${3:\sigma^2})$0
endsnippet

context "nvim_in_math()"
snippet stddev "Standard deviation (\sigma)" w
\sigma 
endsnippet

context "nvim_in_math()"
snippet estimator "Estimator hat" w
\hat{${1:\theta}}$0
endsnippet

context "nvim_in_math()"
snippet tilde "Tilde accent" w
\tilde{${1:x}}$0
endsnippet

context "nvim_in_math()"
snippet chisq "Chi-squared (\chi^2)" w
\chi^2
endsnippet

context "nvim_in_math()"
snippet zscore "Z-score" w
z = \frac{${1:x} - \mu}{\sigma}$0
endsnippet

context "nvim_in_math()"
snippet confint "Confidence interval (\bar{x} \pm z_{\alpha/2} \frac{\sigma}{\sqrt{n}})" w
\bar{x} \pm z_{\alpha/2} \frac{\sigma}{\sqrt{n}}
endsnippet

# ---- Physics ----

context "nvim_in_math()"
snippet vecF "Force vector (\vec{F})" w
\vec{F}
endsnippet

context "nvim_in_math()"
snippet dot "Time derivative (one dot)" w
\dot{${1:x}}$0
endsnippet

context "nvim_in_math()"
snippet ddot "Second time derivative" w
\ddot{${1:x}}$0
endsnippet

context "nvim_in_math()"
snippet hbar "Reduced Planck constant (\hbar)" w
\hbar 
endsnippet

context "nvim_in_math()"
snippet kB "Boltzmann constant (k_{\mathrm{B}})" w
k_{\mathrm{B}}
endsnippet

context "nvim_in_math()"
snippet deltaT "Change in temperature (\Delta T)" w
\Delta T 
endsnippet

context "nvim_in_math()"
snippet deltaU "Change in internal energy (\Delta U)" w
\Delta U 
endsnippet

context "nvim_in_math()"
snippet dQ "Heat increment (\delta Q)" w
\delta Q 
endsnippet

context "nvim_in_math()"
snippet dW "Work increment (\delta W)" w
\delta W 
endsnippet

context "nvim_in_math()"
snippet newton2 "Newton's second law (\vec{F} = m\vec{a})" w
\vec{F} = m\vec{a}
endsnippet

context "nvim_in_math()"
snippet kinematic "V = v0 + a t (v = v_0 + a t)" w
v = v_0 + a t 
endsnippet

context "nvim_in_math()"
snippet workint "Work as integral (W = \int \vec{F} \cdot d\vec{r})" w
W = \int \vec{F} \cdot d\vec{r}
endsnippet

context "nvim_in_math()"
snippet kinetic "Kinetic energy (E_k = \frac{1}{2} m v^2)" w
E_k = \frac{1}{2} m v^2
endsnippet

context "nvim_in_math()"
snippet potential "Gravitational potential energy (E_p = m g h)" w
E_p = m g h 
endsnippet

context "nvim_in_math()"
snippet heatq "Heat capacity law (Q = m c \Delta T)" w
Q = m c \Delta T 
endsnippet

context "nvim_in_math()"
snippet firstlaw "First law of thermodynamics (\Delta U = Q - W)" w
\Delta U = Q - W 
endsnippet

context "nvim_in_math()"
snippet idealgas "Ideal gas law (p V = n R T)" w
p V = n R T 
endsnippet

context "nvim_in_math()"
snippet entropy "Entropy change (\Delta S = \int \frac{\delta Q}{T})" w
\Delta S = \int \frac{\delta Q}{T}
endsnippet

context "nvim_in_math()"
snippet conserve "Conservation of energy (E_i = E_f)" w
E_i = E_f 
endsnippet

context "nvim_in_math()"
snippet momentum "Momentum (\vec{p} = m\vec{v})" w
\vec{p} = m\vec{v}
endsnippet
