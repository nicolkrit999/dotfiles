snippet use "\usepackage line: type the package name (start of line)" b
\usepackage{${1:package}}
endsnippet

snippet eqa "Numbered equation environment with a label, referenced with \ref{label} (start of line)" b
\begin{equation}\label{${1:label}}
	${2:content}
\end{equation}
endsnippet

# ============================================================================
# Math symbols
#
# Conventions:
# - Symbol snippets are offered ONLY inside math ($..$, $$..$$, \(..\), \[..\] and
#   equation-like environments); the check is nvim_in_math() below.
# - Triggers are the human/LaTeX word, case-sensitive (Greek letters: the name itself).
# - Cursor ends AFTER the expansion. Word-like commands (\leq, \alpha, ...) end with one
#   trailing space so the next typed letter does not glue to the command; postfix snippets
#   (sub, sup, inv, transpose, degree, celsius) have none.
# - Placeholders are in left-to-right tab order, the final cursor is right after the construct.
# - Each snippet has a one-line description (shown by nvim-cmp above the snippet body).
# ============================================================================

global !p
import re as _re
import vim as _vim

# Environments whose body is math.
_MATH_ENVS = {
	"equation", "equation*", "align", "align*", "alignat", "alignat*", "aligned", "gather",
	"gather*", "gathered", "multline", "multline*", "flalign", "flalign*", "eqnarray",
	"eqnarray*", "displaymath", "math", "split", "dmath", "dmath*",
}
# Environments whose body is literal text (no math, no snippets for delimiters either).
_VERB_ENVS = {"verbatim", "verbatim*", "Verbatim", "lstlisting", "minted", "comment", "alltt"}
# Commands whose braced argument is plain text again, even inside math.
_TEXT_CMDS = {"text", "textrm", "textit", "textbf", "mbox", "intertext"}


def _tex_state():
	"""Return "math", "text" or "verb" for the cursor position (insert mode).

	Plain text scan of the buffer from the top to the cursor: needs no vimtex and no syntax
	groups, so it also works with tree-sitter highlighting and in plaintex. Handles $..$, $$..$$,
	\\(..\\), \\[..\\], math environments, % comments, escaped \\$ and \\%, \\text{..} groups
	and verbatim-like environments. A blank line ends $..$, $$..$$ and \\(..\\).
	"""
	row, col = _vim.current.window.cursor
	lines = list(_vim.current.buffer[:row])
	lines[-1] = lines[-1][:col]
	close = None       # closing token of the open math region, None = text mode
	envs = []          # open math environments
	verb = None        # open verbatim-like environment
	text_depth = None  # brace depth that ends a \text{..} group
	depth = 0
	for li, line in enumerate(lines):
		last = li == len(lines) - 1
		if not line.strip():
			if close in ("$", "$$", "\\)"):
				close = None
				text_depth = None
			depth = 0
			continue
		i, n = 0, len(line)
		while i < n:
			c = line[i]
			if verb:
				k = line.find("\\end{" + verb + "}", i)
				if k < 0:
					break
				i = k + len("\\end{" + verb + "}")
				verb = None
				continue
			if c == "%":
				if last:
					return "verb"
				break
			if c == "\\":
				nxt = line[i + 1] if i + 1 < n else ""
				if nxt == "[" and close is None and not envs:
					close = "\\]"
				elif nxt == "]" and close == "\\]":
					close = None
				elif nxt == "(" and close is None and not envs:
					close = "\\)"
				elif nxt == ")" and close == "\\)":
					close = None
				elif nxt.isalpha():
					m = _re.match(r"\\([A-Za-z]+)\*?", line[i:])
					name = m.group(1)
					i += len(m.group(0)) - 1
					if name in ("begin", "end"):
						e = _re.match(r"\{([^}]*)\}", line[i + 1:])
						if e:
							env = e.group(1)
							if name == "begin" and env in _VERB_ENVS and close is None:
								verb = env
							elif name == "begin" and env in _MATH_ENVS and close is None:
								envs.append(env)
							elif name == "end" and envs and env == envs[-1]:
								envs.pop()
							i += len(e.group(0))
					elif name in _TEXT_CMDS and (close or envs) and text_depth is None:
						if line[i + 1:i + 2] == "{":
							text_depth = depth
					i += 1
					continue
				i += 2
				continue
			if c == "{":
				depth += 1
			elif c == "}":
				depth -= 1
				if text_depth is not None and depth == text_depth:
					text_depth = None
			elif c == "$" and not envs and text_depth is None:
				if line[i + 1:i + 2] == "$":
					close = None if close == "$$" else ("$$" if close is None else close)
					i += 1
				else:
					close = None if close == "$" else ("$" if close is None else close)
			i += 1
	if verb:
		return "verb"
	return _fin(close, envs, text_depth)


def _fin(close, envs, text_depth):
	if text_depth is None and (close is not None or envs):
		return "math"
	return "text"


def nvim_in_math():
	"""True inside math, but not right after a backslash word (\\alpha typed by hand)."""
	row, col = _vim.current.window.cursor
	if _re.search(r"\\[A-Za-z]*$", _vim.current.line[:col]):
		return False
	return _tex_state() == "math"


def nvim_not_verbatim():
	"""True outside comments and verbatim-like environments (math or text)."""
	return _tex_state() != "verb"
endglobal

# Remove the math-symbol / math-structure snippets that vim-snippets ships for tex, so only the
# ones below are offered. The block's priority must be higher than vim-snippets' (0) for
# clearsnippets to apply. Non-math snippets (environments, tables, bra/ket, ...) stay.
priority 1
clearsnippets cc inn Nn UU uuu nnn HH DD sum lim prod part ooo => =< == != <= >= lll xx <! !> srt srto ss __ compl conj bar taylor rij pmat bmat lrb lra (?<!\\)(sin|cos|arccot|cot|csc|ln|log|exp|star|perp) ((\d|\w)+)invs

# ----------------------------------------------------------------------------
# Math delimiters (work in text and in math; not in comments or verbatim)
# ----------------------------------------------------------------------------

context "nvim_not_verbatim()"
snippet mk "Inline math $...$ (cursor inside)" w
\$${1}\$$0
endsnippet

context "nvim_not_verbatim()"
snippet dm "Display math \[ ... \] on its own lines (cursor inside)" w
\[
	${1}
\]$0
endsnippet

