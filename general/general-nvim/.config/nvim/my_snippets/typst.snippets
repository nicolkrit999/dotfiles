# Typst snippets (filetype typst; loaded by UltiSnips from my_snippets/)
#
# Conventions:
# - Triggers are the human/LaTeX word and case-sensitive. The math-symbol snippets are offered
#   ONLY inside Typst math ($ ... $); typst_math() below decides that without any plugin.
# - Symbols Typst already completes under the same word (alpha, infinity, sum, integral sign,
#   forall, in, subset, ...) have no snippet here; only words Typst does not know (neq, leq,
#   pm, cdot, implies, ...) and structured forms with placeholders.
# - Cursor rules: the cursor ends AFTER the expansion. Word-like symbols end with one space so the
#   next letter does not glue to the name (eq.not x, not eq.notx). Attaching snippets (sub, sup,
#   inv, transpose, celsius) have no space. Placeholders go left to right, $0 after the construct.
# - Each snippet has a one-line description (shown by nvim-cmp above the snippet body).
# - Option w: the trigger is also recognised right after ( [ , and the like, not only after a space.
# - Option i (sub sup inv transpose celsius): attaches to what was typed before, also in mid-word (xsub).

priority 0

global !p
import re

def _typst_before_cursor():
	"""Source text from the start of the buffer up to the cursor, with comments, escapes and
	closed raw blocks blanked out. Returns (text, in_raw)."""
	row, _ = vim.current.window.cursor
	before = vim.eval("strpart(getline('.'), 0, col('.') - 1)")
	text = "\n".join(list(vim.current.buffer[: row - 1]) + [before])
	text = re.sub(r"\\.", "  ", text)                      # escaped chars such as \$ and \`
	text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)       # block comments
	text = re.sub(r"(?m)(?<![:\w])//.*$", "", text)          # line comments (not URLs like https://)
	text = re.sub(r"```.*?```", " ", text, flags=re.S)       # closed fenced raw blocks
	text = re.sub(r"`[^`\n]*`", " ", text)                  # closed inline raw
	return text, ("`" in text)                               # a leftover backtick = inside raw

def typst_math():
	"""True when the cursor is inside $ ... $ (inline or display): odd number of unescaped $ before it."""
	text, in_raw = _typst_before_cursor()
	return (not in_raw) and text.count("$") % 2 == 1

def typst_text():
	"""True when the cursor is outside math and outside raw/code text."""
	text, in_raw = _typst_before_cursor()
	return (not in_raw) and text.count("$") % 2 == 0
endglobal

# ----------------------------------------------------------------------------
# Math delimiters (outside math only)
# ----------------------------------------------------------------------------

context "typst_text()"
snippet mk "Inline math $...$ (no spaces inside the dollars), cursor inside" w
\$${1}\$$0
endsnippet

context "typst_text()"
snippet dm "Display math $ ... $ (spaces inside the dollars), cursor inside" w
\$ ${1} \$$0
endsnippet

# ----------------------------------------------------------------------------
# Relations and operators
# ----------------------------------------------------------------------------

context "typst_math()"
snippet neq "not equal (≠)" w
eq.not 
endsnippet

context "typst_math()"
snippet leq "less or equal (≤)" w
lt.eq 
endsnippet

context "typst_math()"
snippet geq "greater or equal (≥)" w
gt.eq 
endsnippet

context "typst_math()"
snippet ll "much less (≪)" w
lt.double 
endsnippet

context "typst_math()"
snippet gg "much greater (≫)" w
gt.double 
endsnippet

context "typst_math()"
snippet sim "similar, distributed as (∼)" w
tilde.op 
endsnippet

context "typst_math()"
snippet simeq "asymptotically equal (≃)" w
tilde.eq 
endsnippet

context "typst_math()"
snippet cong "congruent (≅)" w
tilde.equiv 
endsnippet

context "typst_math()"
snippet propto "proportional to (∝)" w
prop 
endsnippet

context "typst_math()"
snippet pm "plus minus (±)" w
plus.minus 
endsnippet

context "typst_math()"
snippet mp "minus plus (∓)" w
minus.plus 
endsnippet

context "typst_math()"
snippet cdot "dot product, multiplication dot (⋅)" w
dot.op 
endsnippet

context "typst_math()"
snippet circ "composition (∘)" w
compose 
endsnippet

context "typst_math()"
snippet oplus "direct sum (⊕)" w
plus.o 
endsnippet

context "typst_math()"
snippet otimes "tensor product (⊗)" w
times.o 
endsnippet

context "typst_math()"
snippet celsius "degrees Celsius, attaches to the number before (°C)" i
degree "C"$0
endsnippet

context "typst_math()"
snippet ldots "dots on the line (…)" w
dots.h 
endsnippet

context "typst_math()"
snippet cdots "centered dots (⋯)" w
dots.h.c 
endsnippet

context "typst_math()"
snippet vdots "vertical dots (⋮)" w
dots.v 
endsnippet

context "typst_math()"
snippet ddots "diagonal dots (⋱)" w
