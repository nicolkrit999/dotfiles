endsnippet

context "typst_math()"
snippet colvec "column vector" w
vec(${1:a}, ${2:b}, ${3:c})$0
endsnippet

context "typst_math()"
snippet matrix2 "2x2 matrix" w
mat(${1:a}, ${2:b}; ${3:c}, ${4:d})$0
endsnippet

context "typst_math()"
snippet matrix3 "3x3 matrix" w
mat(${1:a}, ${2:b}, ${3:c}; ${4:d}, ${5:e}, ${6:f}; ${7:g}, ${8:h}, ${9:i})$0
endsnippet

context "typst_math()"
snippet detmat "determinant bars around a 2x2 matrix" w
mat(delim: "|", ${1:a}, ${2:b}; ${3:c}, ${4:d})$0
endsnippet

context "typst_math()"
snippet trace "trace" w
op("tr")(${1:A})$0
endsnippet

context "typst_math()"
snippet rank "rank" w
op("rank")(${1:A})$0
endsnippet

context "typst_math()"
snippet image "image of a map" w
op("im")(${1:A})$0
endsnippet

context "typst_math()"
snippet span "span" w
op("span")(${1:v_1}, ${2:v_2})$0
endsnippet

context "typst_math()"
snippet inner "inner product" w
chevron.l ${1:u}, ${2:v} chevron.r $0
endsnippet

context "typst_math()"
snippet cross "cross product" w
${1:a} times ${2:b} $0
endsnippet

context "typst_math()"
snippet identity "identity matrix" w
I_(${1:n})$0
endsnippet

context "typst_math()"
snippet eigen "eigenvalue equation" w
${1:A} bold(v) = lambda bold(v)$0
endsnippet

# ----------------------------------------------------------------------------
# Statistics and probability
# ----------------------------------------------------------------------------

context "typst_math()"
snippet mean "sample mean (bar)" w
overline(${1:x})$0
endsnippet

context "typst_math()"
snippet variance "variance" w
op("Var")(${1:X})$0
endsnippet

context "typst_math()"
snippet covariance "covariance" w
op("Cov")(${1:X}, ${2:Y})$0
endsnippet

context "typst_math()"
snippet expect "expected value" w
bb(E)[${1:X}]$0
endsnippet

context "typst_math()"
snippet Prob "probability" w
bb(P)(${1:A})$0
endsnippet

context "typst_math()"
snippet given "conditional probability" w
bb(P)(${1:A} | ${2:B})$0
endsnippet

context "typst_math()"
snippet normaldist "normal distribution" w
${1:X} tilde.op cal(N)(${2:mu}, ${3:sigma^2})$0
endsnippet

context "typst_math()"
snippet stddev "standard deviation (σ)" w
sigma 
endsnippet

context "typst_math()"
snippet estimator "estimator with hat" w
hat(${1:theta})$0
endsnippet

context "typst_math()"
snippet chisq "chi-squared (χ²)" w
chi^2 
endsnippet

context "typst_math()"
snippet zscore "z-score" w
z = (${1:x} - mu)/sigma $0
endsnippet

context "typst_math()"
snippet confint "confidence interval for the mean" w
overline(x) plus.minus z_(alpha/2) sigma/sqrt(n)$0
endsnippet

