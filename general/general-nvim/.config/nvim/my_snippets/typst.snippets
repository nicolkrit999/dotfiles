# ----------------------------------------------------------------------------
# Roots and scripts
# ----------------------------------------------------------------------------

context "typst_math()"
snippet nroot "n-th root" w
root(${1:n}, ${2:x})$0
endsnippet

context "typst_math()"
snippet sub "subscript, attaches to what is before" i
_(${1:i})$0
endsnippet

context "typst_math()"
snippet sup "superscript, attaches to what is before" i
^(${1:n})$0
endsnippet

context "typst_math()"
snippet inv "inverse exponent -1, attaches to what is before" i
^(-1)$0
endsnippet

context "typst_math()"
snippet transpose "transpose exponent T, attaches to what is before" i
^(T)$0
endsnippet

# ----------------------------------------------------------------------------
# Calculus and analysis
# ----------------------------------------------------------------------------

context "typst_math()"
snippet limit "limit" w
lim_(${1:x} -> ${2:a}) ${3:f(x)} $0
endsnippet

context "typst_math()"
snippet sumn "sum with bounds" w
sum_(${1:i}=${2:1})^(${3:n}) ${4:a_i} $0
endsnippet

context "typst_math()"
snippet prodn "product with bounds" w
product_(${1:i}=${2:1})^(${3:n}) ${4:a_i} $0
endsnippet

context "typst_math()"
snippet integral "indefinite integral with dif x" w
integral ${1:f(x)} dif ${2:x} $0
endsnippet

context "typst_math()"
snippet defint "definite integral with bounds" w
integral_(${1:a})^(${2:b}) ${3:f(x)} dif ${4:x} $0
endsnippet

context "typst_math()"
snippet iint "double integral" w
integral.double_(${1:D}) ${2:f} dif A $0
endsnippet

context "typst_math()"
snippet iiint "triple integral" w
integral.triple_(${1:V}) ${2:f} dif V $0
endsnippet

context "typst_math()"
snippet oint "closed line integral" w
integral.cont_(${1:C}) ${2:F} dot.op dif bold(r)$0
endsnippet

context "typst_math()"
snippet deriv "derivative d f / d x" w
(dif ${1:f})/(dif ${2:x})$0
endsnippet

context "typst_math()"
snippet pderiv "partial derivative" w
(partial ${1:f})/(partial ${2:x})$0
endsnippet

context "typst_math()"
snippet deriv2 "second derivative" w
(dif^2 ${1:f})/(dif ${2:x}^2)$0
endsnippet

context "typst_math()"
snippet grad "gradient" w
nabla ${1:f} $0
endsnippet

context "typst_math()"
snippet divergence "divergence" w
nabla dot.op ${1:bold(F)} $0
endsnippet

context "typst_math()"
snippet curl "curl" w
nabla times ${1:bold(F)} $0
endsnippet

context "typst_math()"
snippet laplacian "Laplacian" w
nabla^2 ${1:f} $0
endsnippet

context "typst_math()"
snippet bigO "big-O" w
O(${1:n})$0
endsnippet

context "typst_math()"
snippet seq "sequence indexed by the naturals" w
(${1:a}_(${2:n}))_($2 in NN)$0
endsnippet

context "typst_math()"
snippet epsdelta "epsilon-delta quantifiers" w
forall epsilon.alt > 0 thick exists delta > 0 : $0
endsnippet

