context "typst_math()"
snippet vecF "force vector" w
arrow(F)$0
endsnippet

context "typst_math()"
snippet ddot "second time derivative (double dot)" w
dot.double(${1:x})$0
endsnippet

context "typst_math()"
snippet hbar "reduced Planck constant (ħ)" w
planck 
endsnippet

context "typst_math()"
snippet kB "Boltzmann constant" w
k_"B"$0
endsnippet

context "typst_math()"
snippet deltaT "change in temperature" w
Delta T $0
endsnippet

context "typst_math()"
snippet deltaU "change in internal energy" w
Delta U $0
endsnippet

context "typst_math()"
snippet dQ "heat increment" w
delta Q $0
endsnippet

context "typst_math()"
snippet dW "work increment" w
delta W $0
endsnippet

context "typst_math()"
snippet newton2 "Newton's second law" w
arrow(F) = m arrow(a)$0
endsnippet

context "typst_math()"
snippet kinematic "velocity with constant acceleration" w
v = v_0 + a t $0
endsnippet

context "typst_math()"
snippet workint "work as a line integral" w
W = integral arrow(F) dot.op dif arrow(r)$0
endsnippet

context "typst_math()"
snippet kinetic "kinetic energy" w
E_k = 1/2 m v^2 $0
endsnippet

context "typst_math()"
snippet potential "gravitational potential energy" w
E_p = m g h $0
endsnippet

context "typst_math()"
snippet heatq "heat from heat capacity" w
Q = m c Delta T $0
endsnippet

context "typst_math()"
snippet firstlaw "first law of thermodynamics" w
Delta U = Q - W $0
endsnippet

context "typst_math()"
snippet idealgas "ideal gas law" w
p V = n R T $0
endsnippet

context "typst_math()"
snippet entropy "entropy change" w
Delta S = integral (delta Q)/T $0
endsnippet

context "typst_math()"
snippet conserve "conservation of energy" w
E_i = E_f $0
endsnippet

context "typst_math()"
snippet momentum "momentum" w
arrow(p) = m arrow(v)$0
endsnippet
