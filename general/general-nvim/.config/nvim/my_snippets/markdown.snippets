snippet td "tl;dr line (start of line)" bw
tl;dr: ${1:summary}
endsnippet

# =============================================================================
# Math snippets (LaTeX syntax inside $..$ and $$..$$)
# The math symbols expand only where the cursor is inside math; the two
# delimiter snippets (mk, dm) only outside code. Detection is a small scanner
# (mdmath_*): fenced code blocks, YAML front matter, inline code spans and
# backslash-escaped dollars are skipped; a lone dollar sign in prose (a price)
# does not start math. Expansion ends AFTER the symbol; word-like commands get
# one trailing space.
# No vim-snippets entry in the markdown scope uses these triggers, so no
# priority or clearsnippets is needed here.
# =============================================================================
global !p
import re as _mdm_re

# Cache of the last decision, so scanning the buffer happens once per
# (buffer, text version, cursor) even if many snippets ask.
_mdm_cache = {}

def _mdm_scan_line(line, disp):
	"""Scan one line. disp = inside a $$ block when the line starts.
	Returns (disp_at_end, regions, codes):
	  regions = [(lo, hi)] insertion columns (char index) that are math
	            (lo <= col <= hi, hi None = to end of line)
	  codes   = [(lo, hi)] insertion columns inside inline code spans."""
	n = len(line)
	regions, codes, singles = [], [], []
	i = 0
	dstart = 0 if disp else None
	while i < n:
		c = line[i]
		if disp:
			if c == '\\':
				i += 2
			elif line.startswith('$$', i):
				regions.append((dstart, i))
				disp = False
				i += 2
			else:
				i += 1
			continue
		if c == '\\':
			i += 2
		elif c == '`':
			j = i
			while j < n and line[j] == '`':
				j += 1
			run = j - i
			k = line.find('`' * run, j)
			while k != -1 and (k + run < n and line[k + run] == '`'):
				# found a longer run: skip over it
				m = k
				while m < n and line[m] == '`':
					m += 1
				k = line.find('`' * run, m)
			if k == -1:
				i = j
			else:
				codes.append((j, k))
				i = k + run
		elif line.startswith('$$', i):
			disp = True
			dstart = i + 2
			i += 2
		elif c == '$':
			singles.append(i)
			i += 1
		else:
			i += 1
	if disp:
		regions.append((dstart, None))
	# pair single dollars with the pandoc rules: opener needs a non-space
	# after it, closer a non-space before it and no digit after it.
	op = None
	def prevc(p): return line[p - 1] if p > 0 else ' '
	def nextc(p): return line[p + 1] if p + 1 < n else ' '
	for p in singles:
		if any(lo <= p < hi + 1 for (lo, hi) in codes):
			continue
		if op is None:
			if not nextc(p).isspace():
				op = p
			continue
		closes = (not prevc(p).isspace()) and not nextc(p).isdigit()
		if closes:
			regions.append((op + 1, p))
			op = None
		elif not nextc(p).isspace() and nextc(op).isdigit():
			op = p  # the earlier opener was a price: restart here
	if op is not None and not nextc(op).isdigit():
		regions.append((op + 1, None))
	return disp, regions, codes

def _mdm_state():
	"""Return ('code'|'math'|'text') for the cursor position in insert mode."""
	import vim
	buf = vim.current.buffer
	row, bcol = vim.current.window.cursor
	key = (buf.number, int(vim.eval('b:changedtick')), row, bcol)
	hit = _mdm_cache.get('k')
	if hit and hit[0] == key:
		return hit[1]
	res = _mdm_compute(buf, row - 1, bcol)
	_mdm_cache['k'] = (key, res)
	return res

def _mdm_compute(buf, lnum, bcol):
	lines = buf[0:lnum + 1]
	cur = lines[lnum]
	col = len(cur.encode('utf-8')[:bcol].decode('utf-8', 'ignore'))
	start = 0
	# YAML front matter at the top of the file
	if lines and lines[0].rstrip() == '---':
		end = None
		for k in range(1, len(buf)):
			if buf[k].rstrip() in ('---', '...'):
				end = k
				break
		if end is not None:
			if lnum <= end:
				return 'code'
			start = end + 1
	fence = None   # (char, length)
	disp = False
	for k in range(start, lnum):
		ln = lines[k]
		if fence is not None:
			m = _mdm_re.match(r'^[ \t>]*(`{3,}|~{3,})[ \t]*$', ln)
			if m and m.group(1)[0] == fence[0] and len(m.group(1)) >= fence[1]:
				fence = None
			continue
		if not disp:
			m = _mdm_re.match(r'^[ \t>]*(`{3,}|~{3,})(.*)$', ln)
			if m and not (m.group(1)[0] == '`' and '`' in m.group(2)):
				fence = (m.group(1)[0], len(m.group(1)))
				continue
		disp, _r, _c = _mdm_scan_line(ln, disp)
	if fence is not None:
		return 'code'
	if not disp:
		m = _mdm_re.match(r'^[ \t>]*(`{3,}|~{3,})(.*)$', cur)
		if m and not (m.group(1)[0] == '`' and '`' in m.group(2)):
			return 'code'
	d2, regions, codes = _mdm_scan_line(cur, disp)
	for lo, hi in codes:
		if lo <= col <= hi:
			return 'code'
	for lo, hi in regions:
		if col >= lo and (hi is None or col <= hi):
			return 'math'
	return 'text'

def mdmath_in_math():
	"""True when the cursor is inside $..$ or $$..$$ (not in code)."""
	return _mdm_state() == 'math'

def mdmath_not_in_code():
	"""True when the cursor is not inside code, front matter or fenced block."""
	return _mdm_state() != 'code'
endglobal

# ---- Math delimiters ---------------------------------------------------------

context "mdmath_not_in_code()"
snippet mk "Inline math $...$ (cursor inside)" w
\$${1}\$$0
endsnippet

context "mdmath_not_in_code()"
